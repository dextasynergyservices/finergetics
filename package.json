{
  "name": "finergetics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/server/db/seed.ts",
    "admin:create": "bun run scripts/create-admin.ts",
    "analyze": "ANALYZE=true next build",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "8.21.2",
    "@tiptap/html": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "next-cloudinary": "^6.19.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "resend": "^6.32.1",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@next/bundle-analyzer": "^16.4.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
